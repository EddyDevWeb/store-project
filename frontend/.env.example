# URL base de la API del backend (incluye /api al final)
# Local: http://localhost:5000/api
# Producción (Render): https://tu-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Client ID de Google OAuth (debe ser el mismo que GOOGLE_CLIENT_ID del backend)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
