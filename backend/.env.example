# Puerto del servidor API (Render lo asigna automáticamente)
PORT=5000

# Cadena de conexión a MongoDB (Atlas en producción)
# Ejemplo Atlas: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/techstore?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/techstore

# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Client ID de Google OAuth (login con Google)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# URLs permitidas del frontend para CORS y redirecciones de Stripe.
# Acepta una lista separada por comas. Los dominios *.vercel.app se aceptan automáticamente.
CLIENT_URL=http://localhost:5173

# Clave secreta de Stripe (debe empezar por sk_test_ para el modo de prueba)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Correo SMTP (opcional) ---
# Si defines SMTP_HOST, el backend enviará correos reales.
# Si se dejan vacíos, se usará una cuenta de prueba de Ethereal (no llegan correos reales).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TechStore" <no-reply@techstore.dev>
